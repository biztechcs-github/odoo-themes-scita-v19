                    id="request_for_quote_button"
                    data-bs-toggle="modal"
                    data-bs-target="#cfp_pop_up"
                    href="#"
                    t-att-data-product_id="product.id"
                    class="btn btn-primary btn_cta mt-2">
                        Request Quote
                    </a>
                </t>

            </t>
        </xpath>

    </template>
